PORT=3700                          # Railway: auto-injected
NODE_ENV=production
REDIS_URL=                         # Railway: add Redis plugin → auto-injected
INTERNAL_SERVICE_SECRET=           # Railway: share from core-app service variables
ANTHROPIC_API_KEY=                 # https://console.anthropic.com/settings/keys
OPENAI_API_KEY=                    # https://platform.openai.com/api-keys
OPENROUTER_API_KEY=                # https://openrouter.ai/keys (optional)
OPENROUTER_BASE_MODEL=meta-llama/llama-3.2-3b-instruct:free
TOGETHER_API_KEY=                  # https://api.together.xyz/settings/api-keys (optional)
OLLAMA_BASE_URL=                   # Railway: http://ollama.railway.internal:11434 (optional)
OLLAMA_MODEL=llama3.2
LOG_LEVEL=info
