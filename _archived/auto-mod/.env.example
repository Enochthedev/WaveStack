# =============================================================================
#  auto-mod — Service Environment
#  Railway auto-injects: PORT, DATABASE_URL, REDIS_URL
# =============================================================================

PORT=8700
# Railway: auto-injected

NODE_ENV=development
# Railway: set to "production"

# ─── Database & Cache ────────────────────────────────────────────────────────
DATABASE_URL=postgresql://postgres:wave@postgres:5432/wave
# Railway: auto-injected by Postgres plugin

REDIS_URL=redis://redis:6379
# Railway: auto-injected by Redis plugin

# ─── AI Integration ──────────────────────────────────────────────────────────
AI_PERSONALITY_URL=http://ai-personality:8200
# Railway: AI_PERSONALITY_URL=http://ai-personality.railway.internal
USE_AI_MODERATION=true

# ─── Toxicity Detection ──────────────────────────────────────────────────────
TOXICITY_THRESHOLD=0.7
USE_DETOXIFY=true

# ─── Spam Detection ──────────────────────────────────────────────────────────
SPAM_THRESHOLD=0.6
MAX_CAPS_RATIO=0.7
MAX_EMOJIS=10
MAX_MENTIONS=5
MAX_LINKS=2
MIN_MESSAGE_LENGTH=1
MAX_MESSAGE_LENGTH=500

REPEAT_MESSAGE_COUNT=3
REPEAT_MESSAGE_WINDOW=60

# ─── Link Moderation ─────────────────────────────────────────────────────────
ALLOWED_DOMAINS=youtube.com,youtu.be,twitch.tv,twitter.com,x.com
BLOCKED_DOMAINS=
CHECK_LINK_SAFETY=true

# ─── Actions ─────────────────────────────────────────────────────────────────
AUTO_DELETE=true
AUTO_TIMEOUT=false
AUTO_BAN=false
TIMEOUT_DURATION=300
VIOLATIONS_FOR_BAN=5

# ─── Whitelist ───────────────────────────────────────────────────────────────
WHITELIST_ROLES=mod,vip,broadcaster,admin
WHITELIST_USERS=

LOG_ALL_MESSAGES=false
LOG_VIOLATIONS=true
LOG_LEVEL=INFO
