# =============================================================================
#  link-router — Service Environment
#  Railway auto-injects: PORT, DATABASE_URL, REDIS_URL
# =============================================================================

PORT=4200
# Railway: auto-injected

NODE_ENV=development
# Railway: set to "production"

# ─── Database & Cache ────────────────────────────────────────────────────────
DATABASE_URL=postgresql://postgres:wave@postgres:5432/wave
# Railway: auto-injected by Postgres plugin

REDIS_URL=redis://redis:6379
# Railway: auto-injected by Redis plugin

# ─── Public Base URL ─────────────────────────────────────────────────────────
# Used when generating shortened URLs and UTM links
PUBLIC_BASE_URL=http://localhost:4200
# Railway: PUBLIC_BASE_URL=https://<link-router-public-domain>

# ─── Core App ────────────────────────────────────────────────────────────────
CORE_API_URL=http://core-app:3000/api
# Railway: CORE_API_URL=http://core-app.railway.internal/api

INTERNAL_SERVICE_SECRET=dev-internal-secret

LOG_LEVEL=info
