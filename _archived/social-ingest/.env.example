# =============================================================================
#  social-ingest — Service Environment
#  Railway auto-injects: PORT, DATABASE_URL, REDIS_URL
# =============================================================================

PORT=8100
# Railway: auto-injected

NODE_ENV=development
# Railway: set to "production"

# ─── Database & Cache ────────────────────────────────────────────────────────
DATABASE_URL=postgresql://postgres:wave@postgres:5432/wave
# Railway: auto-injected by Postgres plugin

REDIS_URL=redis://redis:6379
# Railway: auto-injected by Redis plugin

# ─── Discord ─────────────────────────────────────────────────────────────────
DISCORD_BOT_TOKEN=
DISCORD_GUILD_IDS=                  # Comma-separated guild IDs to ingest from

# ─── Twitch IRC ──────────────────────────────────────────────────────────────
TWITCH_USERNAME=
TWITCH_OAUTH_TOKEN=oauth:
TWITCH_CHANNELS=                    # Comma-separated channels

# ─── Twitch API ──────────────────────────────────────────────────────────────
TWITCH_CLIENT_ID=
TWITCH_CLIENT_SECRET=

# ─── YouTube ─────────────────────────────────────────────────────────────────
YOUTUBE_API_KEY=
YOUTUBE_CHANNEL_IDS=                # Comma-separated channel IDs

# ─── Twitter / X ─────────────────────────────────────────────────────────────
TWITTER_API_KEY=
TWITTER_API_SECRET=
TWITTER_BEARER_TOKEN=

# ─── Rate Limiting ───────────────────────────────────────────────────────────
RATE_LIMIT_REQUESTS=100
RATE_LIMIT_WINDOW=60000

RETENTION_DAYS=30

LOG_LEVEL=info
