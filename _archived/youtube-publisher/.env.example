# =============================================================================
#  youtube-publisher — Service Environment
#  Railway auto-injects: PORT, DATABASE_URL, REDIS_URL
#
#  Railway note: UPLOAD_DIR, TEMP_DIR, CREDENTIALS_DIR are ephemeral.
#  Use R2/S3 for video uploads and store OAuth credentials in the database.
# =============================================================================

PORT=8500
# Railway: auto-injected

NODE_ENV=development
# Railway: set to "production"

# ─── Database & Cache ────────────────────────────────────────────────────────
DATABASE_URL=postgresql://postgres:wave@postgres:5432/wave
# Railway: auto-injected by Postgres plugin

REDIS_URL=redis://redis:6379
# Railway: auto-injected by Redis plugin

# ─── YouTube OAuth ───────────────────────────────────────────────────────────
# https://console.cloud.google.com/apis/credentials → Create OAuth 2.0 Client
# Enable: YouTube Data API v3
YOUTUBE_CLIENT_ID=
YOUTUBE_CLIENT_SECRET=
YOUTUBE_REDIRECT_URI=http://localhost:8500/oauth2callback
# Railway: YOUTUBE_REDIRECT_URI=https://<youtube-publisher-public-domain>/oauth2callback

# ─── Upload Defaults ─────────────────────────────────────────────────────────
DEFAULT_PRIVACY=private             # private | unlisted | public
DEFAULT_CATEGORY=22                 # 22 = People & Blogs
MAX_RETRIES=3

# ─── AI Integration ──────────────────────────────────────────────────────────
THUMBNAIL_GENERATOR_URL=http://thumbnail-generator:8400
AI_PERSONALITY_URL=http://ai-personality:8200
# Railway:
# THUMBNAIL_GENERATOR_URL=http://thumbnail-generator.railway.internal
# AI_PERSONALITY_URL=http://ai-personality.railway.internal

AUTO_GENERATE_THUMBNAILS=true
USE_AI_DESCRIPTIONS=true
USE_AI_TAGS=true

# ─── Directories ─────────────────────────────────────────────────────────────
# Railway: mount volumes or use R2/S3
UPLOAD_DIR=./uploads
TEMP_DIR=./temp
CREDENTIALS_DIR=./credentials

LOG_LEVEL=INFO
