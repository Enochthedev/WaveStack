# =============================================================================
#  knowledge — Service Environment
#  Railway auto-injects: PORT, DATABASE_URL, REDIS_URL
# =============================================================================

PORT=3900
# Railway: auto-injected

NODE_ENV=development
# Railway: set to "production"

# ─── Database & Cache ────────────────────────────────────────────────────────
DATABASE_URL=postgresql://postgres:wave@postgres:5432/wave
# Railway: auto-injected by Postgres plugin

REDIS_URL=redis://redis:6379
# Railway: auto-injected by Redis plugin

# ─── Vector Store (ChromaDB) ─────────────────────────────────────────────────
CHROMA_HOST=chromadb
CHROMA_PORT=8000
# Railway: CHROMA_HOST=chromadb.railway.internal

# ─── Embeddings ──────────────────────────────────────────────────────────────
# Options: openai | ollama
# Railway: use openai (Ollama requires a GPU instance)
AI_PROVIDER=ollama

OPENAI_API_KEY=
OPENAI_EMBEDDING_MODEL=text-embedding-3-small

OLLAMA_BASE_URL=http://ollama:11434
# Railway: Ollama not recommended — set AI_PROVIDER=openai

# ─── Chunking ────────────────────────────────────────────────────────────────
CHUNK_SIZE=512
CHUNK_OVERLAP=50

LOG_LEVEL=INFO
