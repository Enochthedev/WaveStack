# =============================================================================
#  whatsapp-bot — Service Environment
#  Railway auto-injects: PORT, DATABASE_URL, REDIS_URL
#
#  Railway note: whatsapp-web.js requires a persistent Chromium session.
#  The QR code is scanned once and the session saved to disk.
#  Mount a Railway volume at SESSION_DIR to persist across deploys.
# =============================================================================

NODE_ENV=development
# Railway: set to "production"

# ─── Database & Cache ────────────────────────────────────────────────────────
DATABASE_URL=postgresql://postgres:wave@postgres:5432/wave
# Railway: auto-injected by Postgres plugin

REDIS_URL=redis://redis:6379
# Railway: auto-injected by Redis plugin

# ─── AI Integration ──────────────────────────────────────────────────────────
AI_PERSONALITY_URL=http://ai-personality:8200
# Railway: AI_PERSONALITY_URL=http://ai-personality.railway.internal

# ─── Session Storage ─────────────────────────────────────────────────────────
# Railway: mount a volume here — session is lost on redeploy without it
SESSION_DIR=./.wwebjs_auth

# ─── Bot Behaviour ───────────────────────────────────────────────────────────
CREATOR_USER_ID=default_user
AUTO_RESPOND=false
RESPOND_TO_GROUPS=true

LOG_LEVEL=info
