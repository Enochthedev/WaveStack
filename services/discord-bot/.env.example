# =============================================================================
#  discord-bot — Service Environment
#  Railway auto-injects: PORT, REDIS_URL
#  No DATABASE_URL needed — bot state is stored in Redis + core-app
# =============================================================================

NODE_ENV=development
# Railway: set to "production"

# ─── Discord Credentials ─────────────────────────────────────────────────────
# https://discord.com/developers/applications → New Application → Bot
# Intents required: MESSAGE CONTENT, SERVER MEMBERS, PRESENCE
DISCORD_TOKEN=                      # Bot token — keep this secret
DISCORD_CLIENT_ID=
DISCORD_GUILD_ID=                   # Optional: restrict to a single server in dev

# ─── WaveStack API ───────────────────────────────────────────────────────────
WAVESTACK_API_URL=http://core-app:3000
# Railway: WAVESTACK_API_URL=http://core-app.railway.internal

WAVESTACK_CLIENT_ID=discord-bot-service
WAVESTACK_CLIENT_SECRET=            # Match a client in core-app SERVICE_CLIENTS_JSON

# ─── Redis ───────────────────────────────────────────────────────────────────
REDIS_URL=redis://redis:6379
# Railway: auto-injected by Redis plugin

# ─── Platform Integrations ───────────────────────────────────────────────────
# Twitch (for stream alerts in Discord)
TWITCH_CLIENT_ID=
TWITCH_CLIENT_SECRET=
TWITCH_CHANNEL_NAME=

# YouTube (for stream alerts in Discord)
YOUTUBE_API_KEY=
YOUTUBE_CHANNEL_ID=

# ─── Channel IDs ─────────────────────────────────────────────────────────────
CLIP_CHANNEL_ID=
STREAM_ALERT_CHANNEL_ID=
ANNOUNCEMENT_CHANNEL_ID=

# ─── Bot Behaviour ───────────────────────────────────────────────────────────
BOT_PREFIX=!
COMMAND_COOLDOWN=3000
STREAM_CHECK_INTERVAL=60000

POINTS_PER_MESSAGE=1
POINTS_PER_MINUTE_VOICE=2
DAILY_REWARD=100

# ─── Moderation ──────────────────────────────────────────────────────────────
AUTO_MOD_ENABLED=true
SPAM_THRESHOLD=5
LINK_WHITELIST=youtube.com,twitch.tv,twitter.com,x.com

# ─── OBS WebSocket ───────────────────────────────────────────────────────────
# Runs on the streamer's local machine — not accessible from Railway
# Leave blank when deploying to Railway
OBS_WEBSOCKET_URL=ws://localhost:4455
OBS_WEBSOCKET_PASSWORD=

LOG_LEVEL=info
