# =============================================================================
#  ai-personality (Node.js) — Service Environment
#  Railway auto-injects: PORT, DATABASE_URL, REDIS_URL
#
#  Railway note: "local" and "huggingface" providers require a GPU plan.
#  Use AI_PROVIDER=openai or AI_PROVIDER=anthropic for CPU-only Railway.
# =============================================================================

PORT=8200
# Railway: auto-injected

NODE_ENV=development
# Railway: set to "production"

# ─── Database & Cache ────────────────────────────────────────────────────────
DATABASE_URL=postgresql://postgres:wave@postgres:5432/wave
# Railway: auto-injected by Postgres plugin

REDIS_URL=redis://redis:6379
# Railway: auto-injected by Redis plugin

# ─── AI Provider ─────────────────────────────────────────────────────────────
# Options: openai | anthropic | ollama | huggingface | local
# Railway: use openai or anthropic
AI_PROVIDER=ollama

OPENAI_API_KEY=
OPENAI_MODEL=gpt-4-turbo-preview
OPENAI_EMBEDDING_MODEL=text-embedding-3-small

ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-3-5-haiku-20241022

# Ollama (local dev / GPU host only)
OLLAMA_BASE_URL=http://ollama:11434
OLLAMA_MODEL=llama3.2

# Hugging Face (local dev / GPU only)
HUGGINGFACE_MODEL=meta-llama/Llama-2-7b-chat-hf
HUGGINGFACE_CACHE_DIR=./models/huggingface

# Fine-tuned model from ml-training service
ML_TRAINING_URL=http://ml-training:8300
# Railway: ML_TRAINING_URL=http://ml-training.railway.internal
FINETUNED_MODEL_PATH=./models/finetuned

# ─── Vector Store ────────────────────────────────────────────────────────────
CHROMA_PATH=./data/chroma
CHROMA_COLLECTION=wavestack_memories

# ─── Personality ─────────────────────────────────────────────────────────────
PERSONALITY_TEMPERATURE=0.8
PERSONALITY_MAX_TOKENS=500
CONTEXT_WINDOW=20
MEMORY_RETENTION_DAYS=90

BATCH_SIZE=32
LEARNING_RATE=0.001
MIN_CONFIDENCE=0.7

# ─── Learning Sources ────────────────────────────────────────────────────────
LEARN_FROM_DISCORD=true
LEARN_FROM_TWITCH=true
LEARN_FROM_TELEGRAM=true
LEARN_FROM_TWITTER=true
LEARN_FROM_STREAMS=true

# ─── Features ────────────────────────────────────────────────────────────────
AUTO_RESPOND_ENABLED=true
AUTO_POST_TWITTER=false
SENTIMENT_FILTERING=true
CONTROVERSY_AVOIDANCE=true
NEGATIVITY_THRESHOLD=-0.5

# ─── Twitter (for auto-posting) ──────────────────────────────────────────────
TWITTER_API_KEY=
TWITTER_API_SECRET=
TWITTER_ACCESS_TOKEN=
TWITTER_ACCESS_SECRET=
TWITTER_BEARER_TOKEN=

POST_FREQUENCY_HOURS=4
MIN_ENGAGEMENT_SCORE=0.6
HASHTAG_LIMIT=3

LOG_LEVEL=INFO
