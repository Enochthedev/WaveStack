# =============================================================================
#  ai-personality-py (Python) — Service Environment
#  Railway auto-injects: PORT, DATABASE_URL, REDIS_URL
#
#  Railway note: Ollama / local models require a GPU plan.
#  Use AI_PROVIDER=openai or anthropic for CPU-only Railway deployments.
# =============================================================================

PORT=8200
HOST=0.0.0.0
# Railway: PORT auto-injected

ENVIRONMENT=development
# Railway: set to "production"

# ─── Database & Cache ────────────────────────────────────────────────────────
DATABASE_URL=postgresql://postgres:wave@postgres:5432/wave
# Railway: auto-injected by Postgres plugin

REDIS_URL=redis://redis:6379
# Railway: auto-injected by Redis plugin

# ─── AI Providers ────────────────────────────────────────────────────────────
# Options: openai | anthropic | ollama (or a combination)
# Railway: set to openai or anthropic
AI_PROVIDER=openai

OPENAI_API_KEY=
OPENAI_MODEL=gpt-4-turbo-preview
OPENAI_EMBEDDING_MODEL=text-embedding-3-small

ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-3-5-haiku-20241022

# Ollama (local / GPU only)
OLLAMA_BASE_URL=http://ollama:11434
OLLAMA_MODEL=llama3.2

# ─── Vector Store (ChromaDB) ─────────────────────────────────────────────────
CHROMA_HOST=chromadb
CHROMA_PORT=8000
# Railway: CHROMA_HOST=chromadb.railway.internal
CHROMA_COLLECTION=wavestack_memories

# ─── Personality ─────────────────────────────────────────────────────────────
PERSONALITY_TEMPERATURE=0.8
PERSONALITY_MAX_TOKENS=500
CONTEXT_WINDOW=20
MEMORY_RETENTION_DAYS=90
MIN_MEMORY_IMPORTANCE=5

# ─── Learning Pipeline ───────────────────────────────────────────────────────
LEARN_FROM_DISCORD=true
LEARN_FROM_TWITCH=true
LEARN_FROM_TELEGRAM=true
LEARN_FROM_TWITTER=true
LEARN_FROM_STREAMS=true
BATCH_SIZE=50
LEARNING_INTERVAL_MINUTES=5

# ─── Content Generation ──────────────────────────────────────────────────────
AUTO_RESPOND_ENABLED=true
AUTO_POST_TWITTER=false
CONTENT_REVIEW_REQUIRED=true
MIN_CONFIDENCE_SCORE=0.7

# ─── Safety ──────────────────────────────────────────────────────────────────
SENTIMENT_FILTERING=true
CONTROVERSY_AVOIDANCE=true
MIN_SENTIMENT_SCORE=-0.3
MAX_CONTROVERSY_LEVEL=5
CONTENT_MODERATION=true

# ─── Twitter (for auto-posting) ──────────────────────────────────────────────
TWITTER_API_KEY=
TWITTER_API_SECRET=
TWITTER_ACCESS_TOKEN=
TWITTER_ACCESS_SECRET=
TWITTER_BEARER_TOKEN=

# ─── n8n Integration ─────────────────────────────────────────────────────────
N8N_WEBHOOK_URL=http://n8n:5678/webhook/
# Railway: N8N_WEBHOOK_URL=http://n8n.railway.internal/webhook/
N8N_API_KEY=

LOG_LEVEL=INFO
