# =============================================================================
#  analytics-dashboard — Service Environment
#  Railway auto-injects: PORT, DATABASE_URL, REDIS_URL
# =============================================================================

PORT=8800
# Railway: auto-injected

NODE_ENV=production
# Railway: set to "production"

# ─── Database & Cache ────────────────────────────────────────────────────────
DATABASE_URL=postgresql://postgres:wave@postgres:5432/wave
# Railway: auto-injected by Postgres plugin

REDIS_URL=redis://redis:6379
# Railway: auto-injected by Redis plugin

# ─── Downstream Services ─────────────────────────────────────────────────────
YOUTUBE_PUBLISHER_URL=http://youtube-publisher:8500
SOCIAL_PUBLISHER_URL=http://social-publisher:8600
AI_PERSONALITY_URL=http://ai-personality:8200
CLIPPER_URL=http://clipper:8080
AUTO_MOD_URL=http://auto-mod:8700

# Railway:
# YOUTUBE_PUBLISHER_URL=http://youtube-publisher.railway.internal
# SOCIAL_PUBLISHER_URL=http://social-publisher.railway.internal
# AI_PERSONALITY_URL=http://ai-personality.railway.internal
# CLIPPER_URL=http://clipper.railway.internal
# AUTO_MOD_URL=http://auto-mod.railway.internal

# ─── Analytics Config ────────────────────────────────────────────────────────
METRICS_RETENTION_DAYS=90
CACHE_TTL_SECONDS=300
REAL_TIME_WINDOW_HOURS=24

DAILY_REPORT_ENABLED=true
WEEKLY_REPORT_ENABLED=true
MONTHLY_REPORT_ENABLED=true

LOG_LEVEL=INFO
