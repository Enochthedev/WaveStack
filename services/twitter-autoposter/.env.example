# =============================================================================
#  twitter-autoposter — Service Environment
#  Railway auto-injects: PORT, DATABASE_URL, REDIS_URL
# =============================================================================

NODE_ENV=development
# Railway: set to "production"

# ─── Database & Cache ────────────────────────────────────────────────────────
DATABASE_URL=postgresql://postgres:wave@postgres:5432/wave
# Railway: auto-injected by Postgres plugin

REDIS_URL=redis://redis:6379
# Railway: auto-injected by Redis plugin

# ─── Twitter / X API v2 ──────────────────────────────────────────────────────
# https://developer.twitter.com/en/portal/dashboard
# OAuth 1.0a — read+write permissions required
TWITTER_API_KEY=
TWITTER_API_SECRET=
TWITTER_ACCESS_TOKEN=
TWITTER_ACCESS_SECRET=
TWITTER_BEARER_TOKEN=

# ─── AI Integration ──────────────────────────────────────────────────────────
AI_PERSONALITY_URL=http://ai-personality:8200
# Railway: AI_PERSONALITY_URL=http://ai-personality.railway.internal

# ─── Posting Behaviour ───────────────────────────────────────────────────────
TWITTER_POST_INTERVAL=60        # Minutes between posting cycles
AUTO_GENERATE_TWEETS=true
AUTO_POST_ENABLED=false         # Set true only when live — never enable by default

LOG_LEVEL=INFO
