# =============================================================================
#  telegram-bot — Service Environment
#  Railway auto-injects: PORT, REDIS_URL
# =============================================================================

NODE_ENV=development
# Railway: set to "production"

# ─── Telegram ────────────────────────────────────────────────────────────────
# https://t.me/BotFather → /newbot
TELEGRAM_BOT_TOKEN=

# ─── WaveStack API ───────────────────────────────────────────────────────────
WAVESTACK_API_URL=http://core-app:3000
# Railway: WAVESTACK_API_URL=http://core-app.railway.internal

WAVESTACK_CLIENT_ID=telegram-bot-service
WAVESTACK_CLIENT_SECRET=            # Match a client in core-app SERVICE_CLIENTS_JSON

# ─── AI Personality ──────────────────────────────────────────────────────────
AI_PERSONALITY_URL=http://ai-personality:8200
# Railway: AI_PERSONALITY_URL=http://ai-personality.railway.internal
AI_ENABLED=true

# ─── Redis ───────────────────────────────────────────────────────────────────
REDIS_URL=redis://redis:6379
# Railway: auto-injected by Redis plugin

# ─── Features ────────────────────────────────────────────────────────────────
ECONOMY_ENABLED=true
GAMES_ENABLED=true
CLIPS_ENABLED=true
AI_RESPONSES_ENABLED=true

# ─── Admin ───────────────────────────────────────────────────────────────────
ADMIN_USER_IDS=                     # Comma-separated Telegram user IDs

LOG_LEVEL=info
