# =============================================================================
#  agent-orchestrator — Service Environment
#  Railway auto-injects: PORT, DATABASE_URL, REDIS_URL
# =============================================================================

PORT=3300
# Railway: auto-injected

NODE_ENV=development
# Railway: set to "production"

# ─── Database & Cache ────────────────────────────────────────────────────────
DATABASE_URL=postgresql://postgres:wave@postgres:5432/wave
# Railway: auto-injected by Postgres plugin

REDIS_URL=redis://redis:6379
# Railway: auto-injected by Redis plugin

# ─── Core App ────────────────────────────────────────────────────────────────
CORE_APP_URL=http://core-app:3000/api
# Railway: CORE_APP_URL=http://core-app.railway.internal/api

INTERNAL_SERVICE_SECRET=dev-internal-secret
# Railway: match the value set on core-app

# ─── Downstream Services ─────────────────────────────────────────────────────
MCP_GATEWAY_URL=http://mcp-gateway:4100
SKILLS_URL=http://skills:3200
KNOWLEDGE_URL=http://knowledge:3900
AI_PERSONALITY_URL=http://ai-personality:8200

# Railway:
# MCP_GATEWAY_URL=http://mcp-gateway.railway.internal
# SKILLS_URL=http://skills.railway.internal
# KNOWLEDGE_URL=http://knowledge.railway.internal
# AI_PERSONALITY_URL=http://ai-personality.railway.internal

# ─── AI Providers ────────────────────────────────────────────────────────────
# Options: openai | anthropic | ollama
# Railway: use openai or anthropic — Ollama is not suitable for Railway
AI_PROVIDER=ollama

ANTHROPIC_API_KEY=
OPENAI_API_KEY=

OLLAMA_BASE_URL=http://ollama:11434
OLLAMA_MODEL=llama3.2

# ─── Agent Behaviour ─────────────────────────────────────────────────────────
MAX_CONCURRENT_TASKS=10
APPROVAL_TIMEOUT_HOURS=4

# ─── Observability ───────────────────────────────────────────────────────────
OTEL_ENABLED=false
OTEL_SERVICE_NAME=agent-orchestrator
OTEL_EXPORTER_OTLP_ENDPOINT=

LOG_LEVEL=INFO
