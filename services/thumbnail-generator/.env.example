# =============================================================================
#  thumbnail-generator — Service Environment
#  Railway auto-injects: PORT, DATABASE_URL, REDIS_URL
#
#  Railway note: "local" image generation requires a GPU-enabled plan.
#  Use IMAGE_PROVIDER=openai or stability for CPU-only Railway deployments.
# =============================================================================

PORT=8400
# Railway: auto-injected

NODE_ENV=development
# Railway: set to "production"

# ─── Database & Cache ────────────────────────────────────────────────────────
DATABASE_URL=postgresql://postgres:wave@postgres:5432/wave
# Railway: auto-injected by Postgres plugin

REDIS_URL=redis://redis:6379
# Railway: auto-injected by Redis plugin

# ─── Image Generation ────────────────────────────────────────────────────────
# Options: openai | stability | local
# Railway: openai or stability (local requires GPU)
IMAGE_PROVIDER=local

# OpenAI DALL-E — https://platform.openai.com/api-keys
OPENAI_API_KEY=
DALLE_MODEL=dall-e-3
DALLE_SIZE=1792x1024
DALLE_QUALITY=hd

# Stability AI — https://platform.stability.ai/account/keys
STABILITY_API_KEY=
STABILITY_MODEL=stable-diffusion-xl-1024-v1-0

# Local Stable Diffusion (requires GPU)
SD_MODEL=stabilityai/stable-diffusion-xl-base-1.0
SD_CACHE_DIR=./models/stable-diffusion
SD_USE_REFINER=false

# ─── Output Config ───────────────────────────────────────────────────────────
THUMBNAIL_WIDTH=1280
THUMBNAIL_HEIGHT=720
DEFAULT_FORMAT=PNG
QUALITY=95

DEFAULT_FONT_SIZE=80
DEFAULT_FONT_COLOR=white
DEFAULT_STROKE_COLOR=black
DEFAULT_STROKE_WIDTH=3
FONTS_DIR=./fonts

# Railway: OUTPUT_DIR is ephemeral — thumbnails should be uploaded to R2/S3
OUTPUT_DIR=./thumbnails
CACHE_THUMBNAILS=true
CACHE_EXPIRY_HOURS=24

# ─── AI Integration ──────────────────────────────────────────────────────────
AI_PERSONALITY_URL=http://ai-personality:8200
# Railway: AI_PERSONALITY_URL=http://ai-personality.railway.internal
USE_AI_PROMPTS=true

# ─── Performance ─────────────────────────────────────────────────────────────
MAX_CONCURRENT_GENERATIONS=3
GENERATION_TIMEOUT=120

LOG_LEVEL=INFO
