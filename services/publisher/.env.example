# =============================================================================
#  social-publisher — Service Environment
#  Railway auto-injects: PORT, DATABASE_URL, REDIS_URL
#
#  Railway note: UPLOAD_DIR and SESSIONS_DIR are ephemeral.
#  Use R2/S3 for media storage in production.
# =============================================================================

PORT=8600
# Railway: auto-injected

NODE_ENV=development
# Railway: set to "production"

# ─── Database & Cache ────────────────────────────────────────────────────────
DATABASE_URL=postgresql://postgres:wave@postgres:5432/wave
# Railway: auto-injected by Postgres plugin

REDIS_URL=redis://redis:6379
# Railway: auto-injected by Redis plugin

# ─── Instagram ───────────────────────────────────────────────────────────────
# Per-user tokens are stored encrypted in DB after OAuth flow — not set here
INSTAGRAM_USE_PROXY=false
INSTAGRAM_PROXY=

# ─── TikTok ──────────────────────────────────────────────────────────────────
# Per-user session stored in DB after OAuth flow
TIKTOK_USE_PROXY=false

# ─── Facebook / Meta ─────────────────────────────────────────────────────────
FACEBOOK_APP_ID=
FACEBOOK_APP_SECRET=
# Per-page tokens stored in DB after OAuth

# ─── LinkedIn ────────────────────────────────────────────────────────────────
LINKEDIN_CLIENT_ID=
LINKEDIN_CLIENT_SECRET=
# Per-user tokens stored in DB after OAuth

# ─── Twitter / X ─────────────────────────────────────────────────────────────
TWITTER_API_KEY=
TWITTER_API_SECRET=
# Per-user access tokens stored in DB after OAuth

# ─── AI Integration ──────────────────────────────────────────────────────────
AI_PERSONALITY_URL=http://ai-personality:8200
THUMBNAIL_GENERATOR_URL=http://thumbnail-generator:8400
# Railway:
# AI_PERSONALITY_URL=http://ai-personality.railway.internal
# THUMBNAIL_GENERATOR_URL=http://thumbnail-generator.railway.internal

USE_AI_CAPTIONS=true
USE_AI_HASHTAGS=true

# ─── Directories ─────────────────────────────────────────────────────────────
# Railway: these are ephemeral — migrate to R2/S3 for production
UPLOAD_DIR=./uploads
TEMP_DIR=./temp
SESSIONS_DIR=./sessions

LOG_LEVEL=INFO
