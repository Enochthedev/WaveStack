# =============================================================================
#  clipper — Service Environment
#  Railway auto-injects: PORT
#
#  Railway note: LOCAL storage is ephemeral — use R2 or S3 for persistent clips.
#  PUBLIC_BASE must be your Railway public domain so browsers can fetch clips.
# =============================================================================

PORT=8080
# Railway: auto-injected

NODE_ENV=development
# Railway: set to "production"

# The public-facing URL embedded in API responses so browsers can download clips.
# Docker:  PUBLIC_BASE=http://localhost:8081
# Railway: PUBLIC_BASE=https://<clipper-public-domain>
PUBLIC_BASE=http://localhost:8081

# Where clips are written inside the container.
# Railway: Mount a Railway volume here, or switch to R2/S3 instead.
DATA_DIR=/data

# ─── Storage ─────────────────────────────────────────────────────────────────
# Railway: STORAGE_BACKEND=r2 (local DATA_DIR is ephemeral on Railway)
STORAGE_BACKEND=local

# Cloudflare R2 — recommended for Railway
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=wavestack-clips
R2_PUBLIC_URL=https://pub-xxxx.r2.dev

# AWS S3 (alternative)
S3_ENDPOINT=
S3_REGION=us-east-1
S3_BUCKET=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=

LOG_LEVEL=info
