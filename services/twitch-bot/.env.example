# =============================================================================
#  twitch-bot — Service Environment
#  Railway auto-injects: PORT, REDIS_URL
# =============================================================================

NODE_ENV=development
# Railway: set to "production"

# ─── Twitch IRC (bot account) ─────────────────────────────────────────────────
# Get OAuth token: https://twitchapps.com/tmi/
TWITCH_BOT_USERNAME=
TWITCH_BOT_OAUTH=oauth:
TWITCH_CHANNEL=                     # Default channel (per-org channels stored in DB)

# ─── Twitch API ───────────────────────────────────────────────────────────────
# https://dev.twitch.tv/console/apps → Register application
TWITCH_CLIENT_ID=
TWITCH_CLIENT_SECRET=

# ─── WaveStack API ───────────────────────────────────────────────────────────
WAVESTACK_API_URL=http://core-app:3000
# Railway: WAVESTACK_API_URL=http://core-app.railway.internal

WAVESTACK_CLIENT_ID=twitch-bot-service
WAVESTACK_CLIENT_SECRET=            # Match a client in core-app SERVICE_CLIENTS_JSON

# ─── Redis ───────────────────────────────────────────────────────────────────
REDIS_URL=redis://redis:6379
# Railway: auto-injected by Redis plugin

# ─── Bot Behaviour ───────────────────────────────────────────────────────────
COMMAND_PREFIX=!
COMMAND_COOLDOWN=3000
MOD_ONLY_COMMANDS=ban,timeout,clear,settitle,setgame
VIP_ONLY_COMMANDS=commercial

# ─── Auto Clip Detection ─────────────────────────────────────────────────────
AUTO_CLIP_ENABLED=true
AUTO_CLIP_KEYWORDS=pog,clip,clipped,highlight
AUTO_CLIP_MIN_VIEWERS=10

# ─── Raiding & Shoutouts ─────────────────────────────────────────────────────
AUTO_RAID_ENABLED=false
RAID_TARGET_CHANNELS=
AUTO_SHOUTOUT_RAIDERS=true
AUTO_SHOUTOUT_SUBS=true

# ─── Moderation ──────────────────────────────────────────────────────────────
SPAM_PROTECTION=true
LINK_PROTECTION=true
CAPS_PROTECTION=true
BANNED_WORDS=

# ─── OBS WebSocket ───────────────────────────────────────────────────────────
# Runs on the streamer's local machine — not accessible from Railway
# Leave blank when deploying to Railway
OBS_WEBSOCKET_URL=ws://localhost:4455
OBS_WEBSOCKET_PASSWORD=

LOG_LEVEL=info
