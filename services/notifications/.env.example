PORT=4000                          # Railway: auto-injected
NODE_ENV=production
DATABASE_URL=                      # Railway: add Postgres plugin → auto-injected
REDIS_URL=                         # Railway: add Redis plugin → auto-injected
INTERNAL_SERVICE_SECRET=           # Railway: share from core-app service variables
EXPO_ACCESS_TOKEN=                 # https://expo.dev/accounts/[account]/settings/access-tokens (push notifications)
RESEND_API_KEY=                    # https://resend.com/api-keys (email notifications)
LOG_LEVEL=info
