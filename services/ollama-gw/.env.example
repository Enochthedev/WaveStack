# =============================================================================
#  ollama-gw — Service Environment
#  Railway auto-injects: PORT
#
#  Railway note: Ollama itself is not suitable for Railway (requires GPU and
#  large model downloads). This gateway is typically run on a local GPU host
#  or a dedicated GPU cloud (RunPod, Lambda Labs).
#  On Railway, point AI services directly at OpenRouter or Anthropic instead.
# =============================================================================

PORT=4300
# Railway: auto-injected

NODE_ENV=development

# ─── Ollama Backend ──────────────────────────────────────────────────────────
# URL of the Ollama instance this gateway proxies to
OLLAMA_URL=http://ollama:11434
# Railway (if using a remote GPU): OLLAMA_URL=https://<your-gpu-host>/

OLLAMA_MODEL=llama3.2

# ─── Cache ───────────────────────────────────────────────────────────────────
CACHE_TTL_SECONDS=300

LOG_LEVEL=info
